{
  "name": "solana-rpc-registry",
  "main": "src/index.js",
  "compatibility_date": "2026-03-17",
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "PAY_TO": "B5ZNDYgDCdZZSZQ4qSDrPrEd4XYabvwpVHcX1phrZtR5",
    "PRICE_SOL": "0.1",
    "RPC_FOR_VERIFY": "https://solana-rpc.publicnode.com,https://rpc.ankr.com/solana,https://solana.drpc.org,https://api.mainnet-beta.solana.com",
    "GRANT_DAYS": "30"
  },
  "kv_namespaces": [],
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "RegistryStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistryStore"
      ]
    }
  ]
}
