{
  "name": "solana-rpc-registry",
  "main": "src/index.js",
  "compatibility_date": "2026-03-17",
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "PRICE_USDC": "5",
    "PAY_TO": "",
    "USDC_MINT": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    "RPC_FOR_VERIFY": "https://api.mainnet-beta.solana.com",
    "GRANT_DAYS": "30"
  },
  "kv_namespaces": [],
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "RegistryStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistryStore"
      ]
    }
  ]
}
